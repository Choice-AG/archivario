# Firebase Spark: configuración pública de la aplicación web.
# Sin ella se ofrece exclusivamente la demostración local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Solo servidor. Desarrollo local: ruta al JSON fuera del repositorio.
GOOGLE_APPLICATION_CREDENTIALS=
# Vercel: contenido completo del JSON como variable de entorno privada.
# Configurar en el panel de Vercel; no incluir NEXT_PUBLIC_ ni subir el JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Catálogo IGDB: solo servidor, opcional para añadir juegos manualmente.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Cuentas creadas desde esta fecha deben confirmar su correo para usar IGDB.
# Pon la fecha del despliegue; las cuentas anteriores no se ven afectadas.
NEXT_PUBLIC_EMAIL_VERIFICATION_SINCE=2026-10-03T00:00:00Z
